VITE_API_BASE_URL=http://localhost:8080
# Never place JWT_SECRET or authentication tokens in VITE_* variables.
# Public business contact only, not account data or secrets. Empty disables each action.
VITE_PUBLIC_CONTACT_PHONE=
VITE_PUBLIC_WHATSAPP_PHONE=
# P20 admin-only experimental catalog. Requires separately approved isolated backend/schema activation.
VITE_MARKET_REFERENCES_ENABLED=false
