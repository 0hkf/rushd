DB_NAME=db_rushd
DB_USER=rushd_user
DB_PASSWORD=rushd_password
DB_PORT=5432

# Supply a high-entropy secret via your secret manager/environment. No fallback is provided.
JWT_SECRET=
# TTL overrides are optional; authoritative defaults live in backend/src/main/resources/auth-policy.yml.
# JWT_ACCESS_TOKEN_TTL=
# JWT_REFRESH_TOKEN_TTL=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax
FRONTEND_ORIGIN=https://your-frontend.example
# For local HTTP development ONLY: AUTH_COOKIE_SECURE=false; FRONTEND_ORIGIN=http://localhost:5173
# Spring Boot does not automatically load this file. Export the variables to the backend process.
